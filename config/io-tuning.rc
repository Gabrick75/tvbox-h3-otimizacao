# Ajuste de leitura da NAND. Para desfazer: apagar este arquivo e reiniciar.
on post-fs-data
    write /sys/block/nandd/queue/scheduler deadline
    write /sys/block/nandd/queue/rotational 0
    write /sys/block/nandd/queue/read_ahead_kb 256
    write /sys/block/nandn/queue/scheduler deadline
    write /sys/block/nandn/queue/rotational 0
    write /sys/block/nandn/queue/read_ahead_kb 256

on property:sys.boot_completed=1
    write /sys/block/nandd/queue/scheduler deadline
    write /sys/block/nandd/queue/rotational 0
    write /sys/block/nandd/queue/read_ahead_kb 256
    write /sys/block/nandn/queue/scheduler deadline
    write /sys/block/nandn/queue/rotational 0
    write /sys/block/nandn/queue/read_ahead_kb 256
