diff --git a/src/com/ansub/tvhome/SystemStats.java b/src/com/ansub/tvhome/SystemStats.java
new file mode 100644
index 0000000..cb49177
--- /dev/null
+++ b/src/com/ansub/tvhome/SystemStats.java
@@ -0,0 +1,156 @@
+package com.ansub.tvhome;
+
+import android.os.Environment;
+import android.os.StatFs;
+import android.system.Os;
+import android.system.OsConstants;
+
+import java.io.BufferedReader;
+import java.io.FileReader;
+
+// Readings for the line under the clock. A value the box doesn't expose shows as "--".
+// Not thread safe: call line() from one thread only.
+final class SystemStats {
+    private static final String CPU_DIR = "/sys/devices/system/cpu/";
+    private static final String TEMP = "/sys/class/thermal/thermal_zone0/temp";
+
+    private long lastIdle = -1, lastTotal = -1;
+    private long ramTotalKb = -1;
+
+    String line() {
+        return "CPU " + pct(cpu()) + "   RAM " + pct(ram()) + "   ROM " + pct(rom())
+                + "   PWR " + pct(pwr()) + "   TEMP " + temp();
+    }
+
+    static String placeholder() {
+        return "CPU --   RAM --   ROM --   PWR --   TEMP --";
+    }
+
+    private static String pct(int v) {
+        return v < 0 ? "--" : v + "%";
+    }
+
+    // Busy share of all cores since the previous call, from /proc/stat.
+    private int cpu() {
+        String l = firstLine("/proc/stat");
+        if (l == null || !l.startsWith("cpu ")) return -1;
+        String[] f = l.trim().split("\\s+");
+        long total = 0, idle = 0;
+        try {
+            for (int i = 1; i < f.length && i <= 8; i++) { // user nice system idle iowait irq softirq steal
+                long v = Long.parseLong(f[i]);
+                total += v;
+                if (i == 4 || i == 5) idle += v;
+            }
+        } catch (NumberFormatException e) {
+            return -1;
+        }
+        int out = -1;
+        if (lastTotal >= 0 && total > lastTotal) {
+            out = (int) Math.round(100.0 * (1 - (double) (idle - lastIdle) / (total - lastTotal)));
+        }
+        lastIdle = idle;
+        lastTotal = total;
+        return clamp(out);
+    }
+
+    // Used share of the real RAM. MemTotal is faked on some boxes (8 GB on a 1 GB board), so the total
+    // comes from the pages the kernel actually manages, and MemTotal only as a fallback.
+    private int ram() {
+        if (ramTotalKb < 0) ramTotalKb = managedKb();
+        long avail = -1, memTotal = -1;
+        try (BufferedReader r = new BufferedReader(new FileReader("/proc/meminfo"))) {
+            for (String l; (l = r.readLine()) != null && (avail < 0 || memTotal < 0); ) {
+                if (l.startsWith("MemAvailable:")) avail = digits(l);
+                else if (l.startsWith("MemTotal:")) memTotal = digits(l);
+            }
+        } catch (Exception e) {
+            return -1;
+        }
+        long total = ramTotalKb > 0 ? Math.min(ramTotalKb, memTotal > 0 ? memTotal : ramTotalKb) : memTotal;
+        if (total <= 0 || avail < 0) return -1;
+        return clamp((int) Math.round(100.0 * (total - Math.min(avail, total)) / total));
+    }
+
+    private static long managedKb() {
+        long pages = 0;
+        try (BufferedReader r = new BufferedReader(new FileReader("/proc/zoneinfo"))) {
+            for (String l; (l = r.readLine()) != null; ) {
+                l = l.trim();
+                if (l.startsWith("managed ")) pages += digits(l);
+            }
+            long page = Os.sysconf(OsConstants._SC_PAGESIZE);
+            return pages > 0 ? pages * (page > 0 ? page : 4096) / 1024 : -1;
+        } catch (Exception e) {
+            return -1;
+        }
+    }
+
+    // Used share of the internal storage apps live on.
+    private static int rom() {
+        try {
+            StatFs s = new StatFs(Environment.getDataDirectory().getPath());
+            long total = s.getBlockCountLong(), free = s.getAvailableBlocksLong();
+            if (total <= 0) return -1;
+            return clamp((int) Math.round(100.0 * (total - free) / total));
+        } catch (Exception e) {
+            return -1;
+        }
+    }
+
+    // No power sensor here, so this is the share of the CPU's power budget in use: cores online times
+    // clock speed, against every core at full speed. It drops when the box throttles from heat.
+    private static int pwr() {
+        int online = countCpus(firstLine(CPU_DIR + "online")), possible = countCpus(firstLine(CPU_DIR + "possible"));
+        long cur = digits(firstLine(CPU_DIR + "cpu0/cpufreq/scaling_cur_freq"));
+        long max = digits(firstLine(CPU_DIR + "cpu0/cpufreq/cpuinfo_max_freq"));
+        if (online <= 0 || possible <= 0 || cur <= 0 || max <= 0) return -1;
+        return clamp((int) Math.round(100.0 * online * cur / ((double) possible * max)));
+    }
+
+    private static String temp() {
+        long t = digits(firstLine(TEMP));
+        if (t < 0) return "--";
+        if (t > 1000) t /= 1000; // some kernels report millidegrees
+        return t + "°C";
+    }
+
+    // "0-2,4" -> 4
+    private static int countCpus(String list) {
+        if (list == null || list.trim().isEmpty()) return -1;
+        int n = 0;
+        try {
+            for (String part : list.trim().split(",")) {
+                String[] ab = part.split("-");
+                int a = Integer.parseInt(ab[0].trim()), b = ab.length > 1 ? Integer.parseInt(ab[1].trim()) : a;
+                n += b - a + 1;
+            }
+        } catch (NumberFormatException e) {
+            return -1;
+        }
+        return n;
+    }
+
+    private static String firstLine(String path) {
+        try (BufferedReader r = new BufferedReader(new FileReader(path))) {
+            return r.readLine();
+        } catch (Exception e) {
+            return null;
+        }
+    }
+
+    // First run of digits in s, or -1.
+    private static long digits(String s) {
+        if (s == null) return -1;
+        int i = 0, n = s.length();
+        while (i < n && !Character.isDigit(s.charAt(i))) i++;
+        if (i == n) return -1;
+        long v = 0;
+        while (i < n && Character.isDigit(s.charAt(i))) v = v * 10 + (s.charAt(i++) - '0');
+        return v;
+    }
+
+    private static int clamp(long v) {
+        return v < 0 ? -1 : (int) Math.min(100, v);
+    }
+}
